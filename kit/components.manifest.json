      "doNot": ["不要在页面内自造主题按钮", "主题值只用 vivid/calm"]
    },
    {
      "name": "AppShell",
      "category": "layout",
      "layoutRole": "app-frame",
      "importFrom": "@ai-readable/kit",
      "useWhen": ["后台应用外壳", "需要左侧导航 + 顶栏 + 内容区"],
      "avoidWhen": ["登录页等无导航的独立页", "被嵌入其他应用的局部组件"],
      "requiredProps": ["children"],
      "optionalProps": ["nav", "header", "collapsed", "onCollapse"],
      "slots": ["nav", "header", "children"],
      "variants": ["default"],
      "relatedRules": ["rules/layout.md", "rules/information-architecture.md"],
      "relatedRecipes": ["recipes/dashboard-page.md"],
      "examples": ["examples/dashboard-page.tsx"],
      "figma": { "component": "AppShell", "variants": ["NavState"] },
      "doNot": ["不要在业务页里重写导航壳层", "菜单状态语义走壳层规则，不要硬编码选中色"]
