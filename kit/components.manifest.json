      "requiredProps": ["items"],
      "optionalProps": ["activeKey", "ariaLabel", "onSelect"],
      "slots": ["items"],
      "variants": ["default"],
      "relatedRules": ["rules/information-architecture.md"],
      "relatedRecipes": ["recipes/dashboard-page.md", "recipes/prd-to-pages.md"],
      "examples": ["examples/dashboard-page.tsx"],
      "figma": { "component": "SideNav", "variants": ["State"] },
      "doNot": ["不要用 Tabs 承担主导航", "当前页高亮由 activeKey 控制，不要硬编码颜色"]
    },
    {
      "name": "ThemeToggle",
      "category": "primitive",
      "layoutRole": "theme-control",
      "importFrom": "@ai-readable/kit",
      "useWhen": ["切换 vivid/calm 主题", "预览主题效果", "应用壳层工具区"],
      "avoidWhen": ["业务状态切换", "筛选条件"],
      "requiredProps": [],
      "optionalProps": ["value", "onChange"],
      "slots": [],
      "variants": ["default"],
      "relatedRules": ["rules/theme.md"],
      "relatedRecipes": ["recipes/dashboard-page.md"],
