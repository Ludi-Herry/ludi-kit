{
  "$schema": "./schema/components.schema.json",
  "version": "0.1.0",
  "importEntry": "@ai-readable/kit",
  "frameworks": {
    "react": {
      "status": "active",
      "importEntry": "@ai-readable/kit",
      "implementation": "src/components.tsx",
      "notes": "当前唯一实现。props/slots/variants 命名即框架中立语义。"
    },
    "vue3": {
      "status": "planned",
      "importEntry": "@ai-readable/kit-vue",
      "implementation": null,
      "notes": "平行底座（element-plus 候选）。等第一个真实 Vue 业务再启动；跨框架靠 AI 按同一 kit 重新生成 + harness 验收，禁止代码级机器翻译。"
    },
    "vue2-legacy": {
      "status": "candidate",
      "importEntry": null,
      "implementation": null,
      "notes": "存量系统（Vue2 + element-ui）改造生意，交付形态另议，等真实客户出现再设计。"
    }
  },
  "components": [
    {
      "name": "Button",
      "category": "primitive",
      "layoutRole": "action",
      "importFrom": "@ai-readable/kit",
      "useWhen": ["触发操作", "提交表单", "主/次操作", "危险操作"],
      "avoidWhen": ["纯导航跳转（用链接或 SideNav）", "只做展示的标签（用 Badge）"],
      "requiredProps": ["children"],
      "optionalProps": ["variant", "size", "disabled", "loading", "danger", "icon", "title", "onClick"],
      "slots": ["children", "icon"],
      "variants": ["primary", "secondary", "outline", "ghost", "danger"],
      "relatedRules": ["rules/component-priority.md"],
      "relatedRecipes": ["recipes/button-hierarchy.md"],
      "examples": ["examples/form-page.tsx"],
      "figma": { "component": "Button", "variants": ["Variant", "Size", "State"] },
      "doNot": [
        "不要为了强调重写一套按钮样式",
        "一个区域内不要出现多个 primary 按钮",
        "危险操作用 danger，不要用 primary 加红色硬改"
      ]
    },
    {
      "name": "ConfirmDialog",
      "category": "feedback",
      "layoutRole": "confirmation-dialog",
      "importFrom": "@ai-readable/kit",
      "useWhen": ["高影响且不可撤销操作的对话框确认（批量、金额、权限、数据丢失、对外可见）", "需要明确说明影响范围的短确认", "批量危险操作确认"],
      "avoidWhen": ["查看详情或轻编辑（用 Drawer 候选）", "完整新建/编辑流程（用 form page）", "普通提示或成功反馈"],
      "requiredProps": ["open", "title", "description", "confirmLabel", "onConfirm", "onCancel"],
      "optionalProps": ["cancelLabel", "danger", "loading", "focusFallbackRef"],
      "slots": ["title", "description", "confirmLabel", "cancelLabel"],
      "variants": ["default", "danger"],
      "relatedRules": ["rules/component-priority.md", "rules/anti-patterns.md"],
      "relatedRecipes": ["recipes/dialog-vs-drawer.md"],
      "examples": ["examples/list-page.tsx"],
      "figma": { "component": "Feedback / ConfirmDialog", "variants": ["Tone"] },
      "doNot": [
        "不要用 ConfirmDialog 承载长表单或复杂详情",
        "危险操作必须写清影响对象和不可逆后果",
        "不要把 mask、宽度、zIndex 或 antd 类型暴露给业务页"
      ]
    },
    {
      "name": "Drawer",
      "category": "composite",
      "layoutRole": "side-edit-panel",
      "importFrom": "@ai-readable/kit",
      "useWhen": ["列表上下文内查看详情或完成短编辑", "需要保留背景页面上下文"],
      "avoidWhen": ["危险操作二次确认（用 ConfirmDialog）", "字段多或步骤长的创建流程（用独立表单页）"],
      "requiredProps": ["open", "title", "children", "onClose"],
      "optionalProps": ["footer", "extra", "size", "loading", "closeOnBackdrop", "unmountOnClose"],
      "slots": ["title", "children", "footer", "extra"],
      "variants": ["sm", "md", "lg"],
      "relatedRules": ["rules/component-priority.md"],
      "relatedRecipes": ["recipes/dialog-vs-drawer.md", "recipes/interaction-controls.md"],
      "examples": ["examples/interaction-foundation.tsx"],
      "figma": { "component": "Overlay / Drawer", "variants": ["Size"] },
      "doNot": ["不要允许遮罩点击静默丢失编辑内容", "不要暴露 antd placement、rootClassName 或 portal 类型", "不要在 Drawer 中堆叠完整多步骤流程"]
    },
    {
      "name": "ImportFlow",
      "category": "feedback",
      "layoutRole": "import-workflow",
      "importFrom": "@ai-readable/kit",
      "useWhen": ["文件导入需要选择、处理中、成功、失败完整反馈", "需要复用格式提示与校验错误", "异步导入结果需要保留返回和重试动作"],
      "avoidWhen": ["单纯上传附件（用 Upload）", "同步导出文件（用 Button + 下载回调）", "没有处理状态的普通表单"],
      "requiredProps": ["status"],
      "optionalProps": ["accept", "fileName", "fileLabel", "helpText", "validationError", "title", "description", "details", "actions", "onFileSelect"],
      "slots": ["fileLabel", "helpText", "validationError", "title", "description", "details", "actions"],
      "variants": ["ready", "processing", "success", "error"],
      "relatedRules": ["rules/component-priority.md", "rules/form.md"],
      "relatedRecipes": ["recipes/import-export-flow.md"],
      "examples": ["examples/feedback-states.tsx"],
      "figma": { "component": "Feedback / ImportFlow", "variants": ["Status"] },
      "doNot": [
        "不要让组件自行发起网络请求或决定导入结果",
        "校验失败必须展示具体原因并保留重新选择入口",
        "导出只有按钮和下载回调证据时不要伪造复杂 ExportFlow"
      ]
    },
    {
      "name": "Input",
      "category": "primitive",
      "layoutRole": "form-control",
      "importFrom": "@ai-readable/kit",
      "useWhen": ["单行文本输入", "表单字段", "搜索框"],
      "avoidWhen": ["多行长文本（用 Textarea）", "从固定选项里选（用 Select）"],
      "requiredProps": [],
      "optionalProps": ["id", "label", "aria-label", "aria-labelledby", "aria-describedby", "value", "defaultValue", "placeholder", "disabled", "prefix", "suffix", "status", "onChange"],
      "slots": ["prefix", "suffix"],
      "variants": ["default", "error"],
      "relatedRules": ["rules/form.md"],
      "relatedRecipes": ["recipes/form-page.md"],
      "examples": ["examples/form-page.tsx"],
      "figma": { "component": "Input", "variants": ["State"] },
      "doNot": [
        "不要用 Input 承载选择型输入",
        "错误态用 status='error'，不要行内改边框色"
      ]
    },
    {
      "name": "Textarea",
      "category": "primitive",
      "layoutRole": "form-control",
      "importFrom": "@ai-readable/kit",
      "useWhen": ["多行文本输入", "备注", "说明字段"],
      "avoidWhen": ["单行短文本（用 Input）", "固定选项选择（用 Select）"],
      "requiredProps": [],
      "optionalProps": ["id", "label", "aria-label", "aria-labelledby", "aria-describedby", "value", "defaultValue", "placeholder", "rows", "disabled", "status", "onChange"],
      "slots": [],
      "variants": ["default", "error"],
      "relatedRules": ["rules/form.md"],
      "relatedRecipes": ["recipes/form-page.md"],
      "examples": ["examples/form-page.tsx"],
      "figma": { "component": "Textarea", "variants": ["State"] },
      "doNot": ["不要用 Textarea 承载选择型输入", "不要把长文本塞进 Input"]
    },
    {
      "name": "Select",
      "category": "primitive",
      "layoutRole": "form-control",
      "importFrom": "@ai-readable/kit",
      "useWhen": ["从固定选项中选择", "筛选项", "枚举字段"],
      "avoidWhen": ["自由文本输入（用 Input/Textarea）", "复杂多选树"],
      "requiredProps": ["options"],
      "optionalProps": ["id", "label", "aria-label", "aria-labelledby", "aria-describedby", "value", "defaultValue", "placeholder", "disabled", "status", "onChange"],
      "slots": [],
      "variants": ["default", "error"],
      "relatedRules": ["rules/form.md"],
      "relatedRecipes": ["recipes/form-page.md", "recipes/list-page.md"],
      "examples": ["examples/form-page.tsx", "examples/list-page.tsx"],
      "figma": { "component": "Select", "variants": ["State"] },
      "doNot": ["不要用 Select 做跨页面导航", "选项文案保持业务语义，不要写颜色名"]
    },
    {
      "name": "DatePicker",
      "category": "primitive",
      "layoutRole": "date-control",
      "importFrom": "@ai-readable/kit",
      "useWhen": ["选择日期、日期时间或时间", "业务状态需要稳定字符串值"],
      "avoidWhen": ["选择连续起止区间（用 RangePicker）", "自由文本中偶发提到日期（用 Input）"],
      "requiredProps": [],
      "optionalProps": ["id", "label", "mode", "value", "defaultValue", "placeholder", "disabled", "required", "status", "onChange"],
      "variants": ["date", "datetime", "time"],
      "relatedRecipes": ["recipes/interaction-controls.md"],
      "examples": ["examples/interaction-foundation.tsx"],
      "figma": { "component": "Input / DatePicker", "variants": ["Mode", "State"] },
      "doNot": ["不要向业务层返回 Dayjs 实例", "不要把日期时间值改成不可解析的展示文案", "错误状态必须与字段说明关联"]
    },
    {
      "name": "RangePicker",
      "category": "primitive",
      "layoutRole": "date-range-control",
      "importFrom": "@ai-readable/kit",
      "useWhen": ["选择开始与结束日期", "列表筛选或排期需要连续区间"],
      "avoidWhen": ["只选单个日期（用 DatePicker）", "两个日期彼此无区间关系"],
      "requiredProps": [],
      "optionalProps": ["id", "label", "mode", "value", "defaultValue", "presets", "disabled", "required", "status", "onChange"],
      "variants": ["date", "datetime", "time"],
      "relatedRecipes": ["recipes/interaction-controls.md"],
      "examples": ["examples/interaction-foundation.tsx"],
      "figma": { "component": "Input / RangePicker", "variants": ["Mode", "State"] },
      "doNot": ["不要返回缺少任一端点的半区间", "不要向业务层泄漏日期库类型", "不要在窄容器中写死弹层宽度"]
    },
    {
      "name": "RadioGroup",
      "category": "primitive",
      "layoutRole": "single-choice-control",
      "importFrom": "@ai-readable/kit",
      "useWhen": ["少量选项互斥且需要同时可见", "需要明确默认选择"],
      "avoidWhen": ["选项很多或需要搜索（用 Select/TreeSelect）", "允许多选（用 CheckboxGroup）"],
      "requiredProps": ["options"],
      "optionalProps": ["name", "label", "value", "defaultValue", "layout", "disabled", "required", "status", "onChange"],
      "variants": ["horizontal", "vertical"],
      "relatedRecipes": ["recipes/interaction-controls.md"],
      "examples": ["examples/interaction-foundation.tsx"],
      "figma": { "component": "Choice / RadioGroup", "variants": ["Layout", "State"] },
      "doNot": ["不要用多个独立 Radio 拼接未知组关系", "不要用来承载多选", "选项标签必须描述选择结果"]
    },
    {
      "name": "CheckboxGroup",
      "category": "primitive",
      "layoutRole": "multiple-choice-control",
      "importFrom": "@ai-readable/kit",
      "useWhen": ["少量并列选项允许多选", "所有选项需要同时可见"],
      "avoidWhen": ["只能选一个（用 RadioGroup）", "层级选项或大量选项（用 TreeSelect）"],
      "requiredProps": ["options"],
      "optionalProps": ["name", "label", "value", "defaultValue", "layout", "disabled", "required", "status", "onChange"],
      "variants": ["horizontal", "vertical", "grid"],
      "relatedRecipes": ["recipes/interaction-controls.md"],
      "examples": ["examples/interaction-foundation.tsx"],
      "figma": { "component": "Choice / CheckboxGroup", "variants": ["Layout", "State"] },
      "doNot": ["不要用来表达单个布尔开关（用 Switch）", "不要让必填组在无错误说明时静默失败", "不要塞入无法扫读的长选项列表"]
    },
    {
      "name": "Switch",
      "category": "primitive",
      "layoutRole": "boolean-control",
      "importFrom": "@ai-readable/kit",
      "useWhen": ["切换立即生效的布尔状态", "筛选区启用单个开关条件"],
      "avoidWhen": ["提交表单后才生效的同意项（用 CheckboxGroup）", "危险状态变更（先用 ConfirmDialog）"],
      "requiredProps": [],
      "optionalProps": ["id", "label", "checked", "defaultChecked", "disabled", "loading", "onChange"],
      "variants": ["off", "on", "loading"],
      "relatedRecipes": ["recipes/interaction-controls.md"],
      "examples": ["examples/interaction-foundation.tsx"],
      "figma": { "component": "Choice / Switch", "variants": ["State"] },
      "doNot": ["不要用模糊标签隐藏开启后的影响", "危险切换需要先解释并确认", "不要用颜色作为唯一状态线索"]
    },
    {
      "name": "Upload",
      "category": "primitive",
      "layoutRole": "file-selection-control",
      "importFrom": "@ai-readable/kit",
      "useWhen": ["选择附件、素材或账单文件", "需要限制类型、大小或数量"],
      "avoidWhen": ["完整导入状态机（用 ImportFlow）", "只触发已有文件导出（用 Button）"],
      "requiredProps": [],
      "optionalProps": ["label", "variant", "accept", "multiple", "maxCount", "maxSizeBytes", "items", "triggerLabel", "disabled", "required", "status", "onFilesSelected", "onRemove", "onReject"],
      "variants": ["button", "drag"],
      "relatedRecipes": ["recipes/interaction-controls.md", "recipes/import-export-flow.md"],
      "examples": ["examples/interaction-foundation.tsx"],
      "figma": { "component": "Input / Upload", "variants": ["Type", "State"] },
      "doNot": ["不要在组件内部自动发起网络请求", "不要把文件内容写入日志或文档", "拒绝文件时必须返回具体原因"]
    },
    {
      "name": "TreeSelect",
      "category": "primitive",
      "layoutRole": "hierarchical-choice-control",
      "importFrom": "@ai-readable/kit",
      "useWhen": ["选择组织、分类或区域层级", "多选需要保留父子结构"],
      "avoidWhen": ["扁平少量选项（用 Select/RadioGroup）", "需要搬运两组大量项目（Transfer 尚未进入 kit）"],
      "requiredProps": ["options"],
      "optionalProps": ["label", "selectionMode", "value", "defaultValue", "placeholder", "searchable", "clearable", "loading", "disabled", "required", "status", "onChange"],
      "variants": ["single", "multiple", "checkbox"],
      "relatedRecipes": ["recipes/interaction-controls.md"],
      "examples": ["examples/interaction-foundation.tsx"],
      "figma": { "component": "Input / TreeSelect", "variants": ["Selection", "State"] },
      "doNot": ["不要把层级路径压成无法辨认的扁平选项", "不要让单选 API 返回数组", "不要把业务节点对象泄漏为回调值"]
    },
    {
      "name": "Card",
      "category": "primitive",
      "layoutRole": "container",
      "importFrom": "@ai-readable/kit",
      "useWhen": ["承载一组相关内容", "把内容分块", "Dashboard 里的信息块"],
      "avoidWhen": ["页面级容器（用 PageLayout）", "数据区（用 DataSection）", "指标（用 MetricCard）"],
      "requiredProps": [],
      "optionalProps": ["title", "extra", "footer", "padding", "bordered", "variant"],
      "slots": ["title", "extra", "children", "footer"],
      "variants": ["default", "ghost"],
      "relatedRules": ["rules/layout.md", "rules/anti-patterns.md"],
      "relatedRecipes": ["recipes/dashboard-page.md"],
      "examples": ["examples/dashboard-page.tsx"],
      "figma": { "component": "Card", "variants": ["Type"] },
      "doNot": [
        "不要卡片套卡片",
        "不要把页面级标题放进 Card",
        "不要在 DataSection / MetricCard 外再包一层装饰 Card"
      ]
    },
    {
      "name": "Badge",
      "category": "primitive",
      "layoutRole": "status",
      "importFrom": "@ai-readable/kit",
      "useWhen": ["表达状态", "优先级", "标签分类", "计数"],
      "avoidWhen": ["可点击操作（用 Button）", "长文本说明"],
      "requiredProps": ["children"],
      "optionalProps": ["variant", "appearance"],
      "slots": ["children"],
      "variants": ["primary", "secondary", "success", "warning", "danger", "info", "processing", "geekblue", "cyan", "purple"],
      "relatedRules": ["rules/anti-patterns.md"],
      "relatedRecipes": ["recipes/badge-variants.md"],
      "examples": ["examples/list-page.tsx"],
      "figma": { "component": "Badge", "variants": ["Variant", "Appearance"] },
      "doNot": [
        "不要用颜色表达而非语义（红=重要、紫=页面需要点颜色）",
        "同一业务语义全项目只用一种 variant",
        "不要用 danger 表示'未完成'这种不危险的状态",
        "不要用 className 覆盖背景色，用 variant + appearance"
      ]
    },
    {
      "name": "Tabs",
      "category": "primitive",
      "layoutRole": "inline-navigation",
      "importFrom": "@ai-readable/kit",
      "useWhen": ["同一上下文内切换视图", "详情页分区（技术参数/变更历史/告警）"],
      "avoidWhen": ["页面间跳转（用 SideNav / 路由）", "步骤流程（用 Stepper）"],
      "requiredProps": ["items"],
      "optionalProps": ["defaultActiveKey", "activeKey", "variant", "onChange"],
      "slots": ["items"],
      "variants": ["line", "card"],
      "relatedRules": ["rules/layout.md"],
      "relatedRecipes": ["recipes/detail-page.md"],
      "examples": ["examples/detail-page.tsx"],
      "figma": { "component": "Tabs", "variants": ["Type"] },
      "doNot": ["不要用 Tabs 做跨页面导航", "Tab 数量过多时考虑二级导航"]
    },
    {
      "name": "SideNav",
      "category": "navigation",
      "layoutRole": "primary-navigation",
      "importFrom": "@ai-readable/kit",
      "useWhen": ["应用主导航", "后台左侧菜单", "跨页面跳转"],
