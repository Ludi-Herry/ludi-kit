    {
      "name": "PageLayout",
      "category": "layout",
      "layoutRole": "page-container",
      "importFrom": "@ai-readable/kit",
      "useWhen": ["页面级内容容器", "控制页面密度和最大宽度", "承载 PageHeader 后的业务模块"],
      "avoidWhen": ["单个内容块（用 Card/DataSection/FormSection）", "应用外壳（用 AppShell）"],
      "requiredProps": ["children"],
      "optionalProps": ["density"],
      "slots": ["children"],
      "variants": ["compact", "standard", "loose"],
      "relatedRules": ["rules/layout.md"],
      "relatedRecipes": ["recipes/list-page.md", "recipes/dashboard-page.md", "recipes/detail-page.md", "recipes/form-page.md"],
      "examples": ["examples/list-page.tsx", "examples/dashboard-page.tsx"],
      "figma": { "component": "PageLayout", "variants": ["Density"] },
      "doNot": ["不要用 Card 做页面级容器", "不要在页面根层散落 margin"]
    },
    {
      "name": "ForbiddenState",
      "category": "feedback",
      "layoutRole": "permission-page-state",
      "importFrom": "@ai-readable/kit",
      "useWhen": ["路由或整页资源返回 403", "当前账号没有页面访问权限", "需要给出申请权限或返回入口"],
      "avoidWhen": ["列表查无数据（用空态）", "单个按钮缺少权限（禁用按钮并说明权限点）", "接口临时失败（用错误态）"],
      "requiredProps": [],
      "optionalProps": ["title", "description", "actions"],
      "slots": ["title", "description", "actions"],
      "variants": ["default"],
