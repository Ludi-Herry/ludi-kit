{
  "components": [
    { "name": "Button", "category": "primitive", "role": "action", "useWhen": "触发操作", "variants": ["primary", "secondary", "outline", "ghost", "danger"] },
    { "name": "ConfirmDialog", "category": "feedback", "role": "confirmation-dialog", "useWhen": "高影响且不可撤销操作的对话框确认（批量、金额、权限、数据丢失、对外可见）", "variants": ["default", "danger"] },
    { "name": "Drawer", "category": "composite", "role": "side-edit-panel", "useWhen": "列表上下文内查看详情或完成短编辑", "variants": ["sm", "md", "lg"] },
    { "name": "ImportFlow", "category": "feedback", "role": "import-workflow", "useWhen": "文件导入需要选择、处理中、成功、失败完整反馈", "variants": ["ready", "processing", "success", "error"] },
    { "name": "Input", "category": "primitive", "role": "form-control", "useWhen": "单行文本输入", "variants": ["default", "error"] },
    { "name": "Textarea", "category": "primitive", "role": "form-control", "useWhen": "多行文本输入", "variants": ["default", "error"] },
    { "name": "Select", "category": "primitive", "role": "form-control", "useWhen": "从固定选项中选择", "variants": ["default", "error"] },
    { "name": "DatePicker", "category": "primitive", "role": "date-control", "useWhen": "选择日期、日期时间或时间", "variants": ["date", "datetime", "time"] },
    { "name": "RangePicker", "category": "primitive", "role": "date-range-control", "useWhen": "选择开始与结束日期", "variants": ["date", "datetime", "time"] },
    { "name": "RadioGroup", "category": "primitive", "role": "single-choice-control", "useWhen": "少量选项互斥且需要同时可见", "variants": ["horizontal", "vertical"] },
    { "name": "CheckboxGroup", "category": "primitive", "role": "multiple-choice-control", "useWhen": "少量并列选项允许多选", "variants": ["horizontal", "vertical", "grid"] },
    { "name": "Switch", "category": "primitive", "role": "boolean-control", "useWhen": "切换立即生效的布尔状态", "variants": ["off", "on", "loading"] },
    { "name": "Upload", "category": "primitive", "role": "file-selection-control", "useWhen": "选择附件、素材或账单文件", "variants": ["button", "drag"] },
    { "name": "TreeSelect", "category": "primitive", "role": "hierarchical-choice-control", "useWhen": "选择组织、分类或区域层级", "variants": ["single", "multiple", "checkbox"] },
    { "name": "Card", "category": "primitive", "role": "container", "useWhen": "承载一组相关内容", "variants": ["default", "ghost"] },
    { "name": "Badge", "category": "primitive", "role": "status", "useWhen": "表达状态", "variants": ["primary", "secondary", "success", "warning", "danger", "info", "processing", "geekblue", "cyan", "purple"] },
    { "name": "Tabs", "category": "primitive", "role": "inline-navigation", "useWhen": "同一上下文内切换视图", "variants": ["line", "card"] },
    { "name": "SideNav", "category": "navigation", "role": "primary-navigation", "useWhen": "应用主导航", "variants": ["default"] },
    { "name": "ThemeToggle", "category": "primitive", "role": "theme-control", "useWhen": "切换 vivid/calm 主题", "variants": ["default"] },
    { "name": "AppShell", "category": "layout", "role": "app-frame", "useWhen": "后台应用外壳", "variants": ["default"] },
    { "name": "PageLayout", "category": "layout", "role": "page-container", "useWhen": "页面级内容容器", "variants": ["compact", "standard", "loose"] },
    { "name": "ForbiddenState", "category": "feedback", "role": "permission-page-state", "useWhen": "路由或整页资源返回 403", "variants": ["default"] },
    { "name": "PageHeader", "category": "composite", "role": "page-header", "useWhen": "页面顶部标题区", "variants": ["default", "with-tabs"] },
    { "name": "FilterPanel", "category": "composite", "role": "filter-region", "useWhen": "列表页筛选区", "variants": ["inline", "grid"] },
    { "name": "DataSection", "category": "composite", "role": "data-region", "useWhen": "列表页数据区域", "variants": ["default", "dense"] },
    { "name": "BulkActionBar", "category": "composite", "role": "batch-action-region", "useWhen": "DataGrid 已选择一条或多条记录", "variants": ["default"] },
    { "name": "FormSection", "category": "page-section", "role": "form-section", "useWhen": "表单字段分组", "variants": ["default"] },
    { "name": "MetricCard", "category": "composite", "role": "metric", "useWhen": "Dashboard KPI 指标", "variants": ["default", "compact"] },
    { "name": "ChartFrame", "category": "visualization", "role": "chart-panel", "useWhen": "承载图表标题、口径和操作", "variants": ["ready", "loading", "empty", "error", "sm", "md", "lg"] },
    { "name": "TrendChart", "category": "visualization", "role": "trend-chart", "useWhen": "展示时间或顺序变化趋势", "variants": ["linear", "smooth", "area"] },
    { "name": "BarChart", "category": "visualization", "role": "comparison-chart", "useWhen": "比较分类数值", "variants": ["vertical", "horizontal"] },
    { "name": "DonutChart", "category": "visualization", "role": "composition-chart", "useWhen": "展示整体构成", "variants": ["bottom-legend", "right-legend"] },
    { "name": "GaugeChart", "category": "visualization", "role": "threshold-chart", "useWhen": "展示单一值相对阈值区间", "variants": ["default"] },
    { "name": "DetailHeader", "category": "composite", "role": "detail-header", "useWhen": "详情页顶部实体信息", "variants": ["default", "with-status"] },
    { "name": "DescriptionGrid", "category": "data-display", "role": "key-value-data", "useWhen": "详情页键值信息", "variants": ["2", "3", "4"] },
    { "name": "DataGrid", "category": "data-display", "role": "data-table", "useWhen": "需要分页/排序/选择的数据表", "variants": ["default", "compact"] },
    { "name": "Pagination", "category": "data-display", "role": "pagination-control", "useWhen": "DataGrid 需要展示分页意图", "variants": ["default"] },
    { "name": "Table", "category": "data-display", "role": "simple-table", "useWhen": "少量只读小表", "variants": ["default", "compact"] },
    { "name": "Stepper", "category": "navigation", "role": "process-navigation", "useWhen": "多步骤流程", "variants": ["default"] }
  ],
  "patterns": [
    { "name": "list-page", "title": "列表页 List Page", "useWhen": "后台列表页、需要筛选、需要表格、需要分页", "structure": ["PageLayout", "PageHeader", "FilterPanel", "DataSection > DataGrid + Pagination"] },
    { "name": "dashboard-page", "title": "工作台 Dashboard", "useWhen": "工作台、数据看板、运营驾驶舱、KPI 概览", "structure": ["PageLayout", "PageHeader", "MetricCard 行", "ChartFrame / 内容网格"] },
    { "name": "detail-page", "title": "详情页 Detail Page", "useWhen": "实体详情页、设备/客户/单据详情、Hero + 属性 + 分区", "structure": ["PageLayout", "DetailHeader", "DescriptionGrid", "Tabs > 分区内容"] },
    { "name": "form-page", "title": "表单页 Form Page", "useWhen": "新建/编辑表单、配置页、分组字段录入", "structure": ["PageLayout", "PageHeader", "FormSection 分组", "底部操作区"] },
    { "name": "analytics-dashboard", "title": "分析看板 Analytics Dashboard", "useWhen": "两张以上图表共享时间口径、报表或趋势分析、需要指标、趋势、分类与组成联合解读", "structure": ["PageLayout", "PageHeader", "MetricCard 行", "ChartFrame 网格", "可选 DataSection"] },
    { "name": "situation-screen", "title": "态势大屏 Situation Screen", "useWhen": "全屏值守、实时态势、深色高密度汇报屏、固定大屏或会议墙", "structure": ["screen theme", "全局指标与时间", "12 列动态面板", "实时行动列表"] },
    { "name": "screen-publish-flow", "title": "大屏发布 Screen Publish", "useWhen": "大屏模板选择与配置、投放前检查、三步以内的发布流程", "structure": ["PageLayout", "PageHeader", "Stepper", "模板 Card 网格或 FormSection", "检查与投放结果"] }
  ]
}
