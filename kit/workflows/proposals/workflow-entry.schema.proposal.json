{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-readable.local/schema/workflow-entry.proposal.json",
  "title": "Workflow entry proposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "status", "skillPath", "inputs", "routes", "outputs", "gates"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "status": { "enum": ["proposal", "active", "deprecated"] },
    "skillPath": { "type": "string", "pattern": "^kit/skills/" },
    "inputs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "routes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["renderer", "motion", "figma", "cutout"],
      "properties": {
        "renderer": { "type": "string" },
        "motion": { "type": "string" },
        "figma": { "type": "string" },
        "cutout": { "type": "string" }
      }
    },
    "outputs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "gates": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "ownerNote": { "type": "string" }
  }
}
