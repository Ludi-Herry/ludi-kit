{
  "$schema": "../../../schema/project-description.schema.json",
  "version": "1.0.0",
  "projectId": "tianshu-firmware-canary",
  "contextType": "real-product",
  "product": {
    "name": "天枢固件版本管理",
    "description": "供固件管理员检索版本、判断签名与灰度状态，并进入受控发布操作的生产履约页面。"
  },
  "pages": [
    {
      "id": "production-firmware",
      "route": "/production/firmware",
      "title": "固件版本管理",
      "pattern": "list-page",
      "intent": {
        "goal": "快速找到目标机型的固件版本，判断签名、灰度和发布状态，并进入受权限控制的下一步操作。",
        "primaryAction": "新建固件版本",
        "secondaryActions": ["导出版本列表", "刷新"],
        "successCriteria": [
          "首屏同时展示版本状态与独立签名状态",
          "筛选区支持版本号、机型、版本状态和签名状态",
          "表格使用真实格式的演示数据且不暴露任何密钥",
          "页面只从 @ai-readable/kit barrel 使用组件"
        ]
      },
      "componentPlan": ["PageLayout", "PageHeader", "FilterPanel", "DataSection", "DataGrid", "Pagination", "Badge", "Button", "Input", "Select"],
      "content": {
        "filters": [
          { "name": "firmwareVersion", "label": "固件版本号", "type": "text", "placeholder": "输入版本号" },
          {
            "name": "model",
            "label": "机型",
            "type": "select",
            "options": [
              { "label": "TJ-M1", "value": "tj-m1" },
              { "label": "TJ-S1", "value": "tj-s1" },
              { "label": "TJ-Pro", "value": "tj-pro" }
            ]
          },
          {
            "name": "versionStatus",
            "label": "版本状态",
            "type": "select",
            "options": [
              { "label": "草稿", "value": "draft" },
              { "label": "测试中", "value": "testing" },
              { "label": "灰度中", "value": "canary" },
              { "label": "已全量", "value": "released" },
              { "label": "已回滚", "value": "rolled_back" },
              { "label": "已停用", "value": "deprecated" }
            ]
          },
          {
            "name": "signatureStatus",
            "label": "签名状态",
            "type": "select",
            "options": [
              { "label": "未签名", "value": "unsigned" },
              { "label": "签名中", "value": "signing" },
              { "label": "签名成功", "value": "signed" },
              { "label": "签名失败", "value": "sign_failed" }
            ]
          }
        ],
        "table": {
          "title": "固件版本",
          "rowKey": "version",
          "columns": [
            { "key": "version", "title": "固件版本号" },
            { "key": "model", "title": "机型" },
            { "key": "versionStatus", "title": "版本状态" },
            { "key": "signatureStatus", "title": "签名状态" },
            { "key": "rollout", "title": "灰度比例" },
            { "key": "devices", "title": "绑定设备数" },
            { "key": "publisher", "title": "发布人" },
            { "key": "publishedAt", "title": "发布时间" }
          ],
          "rows": [
            { "version": "v2.4.0-TJ-M1-beta", "model": "TJ-M1", "versionStatus": "测试中", "signatureStatus": "签名成功", "rollout": "—", "devices": 0, "publisher": "林嘉禾", "publishedAt": "—" },
            { "version": "v2.3.2-TJ-M1", "model": "TJ-M1", "versionStatus": "灰度中", "signatureStatus": "签名成功", "rollout": "25%", "devices": 1280, "publisher": "周启明", "publishedAt": "2026-07-16 18:20" },
            { "version": "v2.3.1-TJ-M1", "model": "TJ-M1", "versionStatus": "已全量", "signatureStatus": "签名成功", "rollout": "—", "devices": 4896, "publisher": "周启明", "publishedAt": "2026-07-11 10:08" },
            { "version": "v1.9.8-TJ-S1", "model": "TJ-S1", "versionStatus": "已回滚", "signatureStatus": "签名成功", "rollout": "—", "devices": 742, "publisher": "顾言", "publishedAt": "2026-07-04 15:36" },
            { "version": "v3.0.0-TJ-Pro-rc1", "model": "TJ-Pro", "versionStatus": "草稿", "signatureStatus": "未签名", "rollout": "—", "devices": 0, "publisher": "沈秋", "publishedAt": "—" },
            { "version": "v2.2.7-TJ-M1", "model": "TJ-M1", "versionStatus": "已停用", "signatureStatus": "签名失败", "rollout": "—", "devices": 315, "publisher": "周启明", "publishedAt": "2026-06-18 09:24" }
          ]
        }
      }
    }
  ]
}
