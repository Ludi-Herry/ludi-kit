{
  "$schema": "../../../schema/project-description.schema.json",
  "version": "1.0.0",
  "projectId": "field-service-control",
  "contextType": "real-product",
  "product": {
    "name": "现场服务调度台",
    "description": "帮助调度员分派工单、跟踪现场进度并核对服务结果。"
  },
  "pages": [
    {
      "id": "overview",
      "route": "/overview",
      "title": "服务概览",
      "pattern": "dashboard-page",
      "intent": {
        "goal": "在一屏内判断今日工单负载和超时风险。",
        "primaryAction": "查看超时工单",
        "secondaryActions": ["刷新"],
        "successCriteria": ["首屏展示关键负载指标", "主操作只有一个"]
      },
      "componentPlan": ["PageLayout", "PageHeader", "MetricCard", "Card", "Button"],
      "content": {
        "metrics": [
          { "label": "待分派", "value": 18, "delta": "+3", "trend": "up" },
          { "label": "现场处理中", "value": 42, "delta": "稳定", "trend": "flat" },
          { "label": "超时风险", "value": 5, "delta": "-2", "trend": "down" }
        ]
      }
    },
    {
      "id": "work-orders",
      "route": "/work-orders",
      "title": "工单列表",
      "pattern": "list-page",
      "intent": {
        "goal": "筛选需要处理的工单并进入详情或发起分派。",
        "primaryAction": "新建工单",
        "secondaryActions": ["导出"],
        "successCriteria": ["筛选区位于数据区上方", "列表可识别优先级与负责人"]
      },
      "componentPlan": ["PageLayout", "PageHeader", "FilterPanel", "DataSection", "DataGrid", "Pagination", "Button"],
      "content": {
        "filters": [
          { "name": "keyword", "label": "关键字", "type": "text", "placeholder": "工单号或客户" },
          { "name": "priority", "label": "优先级", "type": "select", "options": [{ "label": "紧急", "value": "urgent" }, { "label": "常规", "value": "normal" }] }
        ],
        "table": {
          "title": "待处理工单",
          "rowKey": "id",
          "columns": [
            { "key": "id", "title": "工单号" },
            { "key": "customer", "title": "客户" },
            { "key": "priority", "title": "优先级" },
            { "key": "owner", "title": "负责人" }
          ],
          "rows": [
            { "id": "WO-2407", "customer": "北岸实验室", "priority": "紧急", "owner": "林师傅" },
            { "id": "WO-2408", "customer": "新桥仓储", "priority": "常规", "owner": "待分派" }
          ]
        }
      }
    },
    {
      "id": "work-order-detail",
      "route": "/work-orders/WO-2407",
      "title": "工单 WO-2407",
      "pattern": "detail-page",
      "intent": {
        "goal": "核对工单上下文、负责人和服务时限。",
        "primaryAction": "更新进度",
        "secondaryActions": ["返回列表"],
        "successCriteria": ["详情字段按语义分组", "主操作对应当前任务"]
      },
      "componentPlan": ["PageLayout", "DetailHeader", "DescriptionGrid", "Button"],
      "content": {
        "details": [
          { "label": "客户", "value": "北岸实验室" },
          { "label": "服务地址", "value": "研发园 2 号楼" },
          { "label": "负责人", "value": "林师傅" },
          { "label": "要求完成", "value": "今天 17:30" }
        ]
      }
    },
    {
      "id": "dispatch",
      "route": "/dispatch",
      "title": "分派工单",
      "pattern": "form-page",
      "intent": {
        "goal": "为待处理工单选择负责人并补充现场说明。",
        "primaryAction": "确认分派",
        "secondaryActions": ["取消"],
        "successCriteria": ["必填项清楚可见", "提交与取消层级明确"]
      },
      "componentPlan": ["PageLayout", "PageHeader", "FormSection", "Input", "Select", "Textarea", "Button"],
      "content": {
        "fields": [
          { "name": "workOrder", "label": "工单号", "control": "input", "required": true, "placeholder": "输入工单号" },
          { "name": "assignee", "label": "负责人", "control": "select", "required": true, "options": [{ "label": "林师傅", "value": "lin" }, { "label": "周师傅", "value": "zhou" }] },
          { "name": "note", "label": "现场说明", "control": "textarea", "required": false, "placeholder": "补充服务背景和注意事项" }
        ]
      }
    }
  ]
}
