{
  "$schema": "../../../schema/project-description.schema.json",
  "version": "1.0.0",
  "projectId": "antd-form-content-fidelity-canary",
  "contextType": "real-product",
  "product": {
    "name": "批处理任务校验台",
    "description": "用于验证普通 AntD form 保留业务步骤、分组和操作文案并隔离验收脚手架的独立非 Holdout fixture。"
  },
  "pages": [
    {
      "id": "form-content-fidelity-canary",
      "route": "/fixtures/form-content-fidelity",
      "title": "新建批处理任务",
      "pattern": "form-page",
      "intent": {
        "goal": "分组录入任务来源、执行策略与数量备注。",
        "primaryAction": "创建任务",
        "secondaryActions": ["保存草稿", "返回列表"],
        "successCriteria": [
          "字段按业务语义分组",
          "主操作保持唯一"
        ]
      },
      "componentPlan": [
        "PageLayout",
        "PageHeader",
        "Stepper",
        "FormSection",
        "Input",
        "Select",
        "Textarea",
        "Button"
      ],
      "content": {
        "fields": [
          {
            "name": "sourceTask",
            "label": "来源任务",
            "control": "select",
            "required": true,
            "placeholder": "请选择来源任务",
            "options": [
              { "label": "TASK-DEMO-01", "value": "task-demo-01" }
            ]
          },
          {
            "name": "policy",
            "label": "执行策略",
            "control": "select",
            "required": true,
            "placeholder": "请选择执行策略",
            "options": [
              { "label": "标准策略", "value": "standard" }
            ]
          },
          {
            "name": "quantity",
            "label": "执行数量",
            "control": "input",
            "required": true,
            "placeholder": "输入执行数量"
          },
          {
            "name": "note",
            "label": "执行备注",
            "control": "textarea",
            "required": false,
            "placeholder": "补充异常处理说明"
          }
        ],
        "formPresentation": {
          "steps": ["选择任务", "绑定策略", "确认执行"],
          "currentStep": 0,
          "sections": [
            { "title": "任务来源", "fieldNames": ["sourceTask"] },
            { "title": "策略配置", "fieldNames": ["policy"] },
            { "title": "数量与备注", "fieldNames": ["quantity", "note"] }
          ],
          "secondaryActions": "visible",
          "acceptanceCriteria": "evaluation-only"
        }
      }
    }
  ]
}
