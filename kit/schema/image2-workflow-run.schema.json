{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-readable.local/schema/image2-workflow-run.schema.json",
  "title": "image2-to-figma-page run record",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "runId", "requestId", "designContext", "routing", "status", "recordedAt", "frozenContext", "stages", "artifacts", "blockers"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": "2.0.0" },
    "runId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "requestId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "designContext": { "enum": ["existing", "exploratory"] },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategyDecisionId", "selectedRoute", "image2Policy", "pipeline"],
      "properties": {
        "strategyDecisionId": { "const": "image2-routing-strategy-amendment-2026-08-14" },
        "selectedRoute": { "enum": ["existing", "exploratory"] },
        "image2Policy": { "enum": ["forbidden", "allowed-visual-exploration-only"] },
        "pipeline": {
          "type": "array",
          "minItems": 5,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 3 }
        }
      }
    },
    "status": { "enum": ["completed", "in-progress", "external-blocked", "failed"] },
    "recordedAt": { "type": "string", "format": "date-time" },
    "frozenContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "contractSha256", "sources", "selectedDirectionId"],
      "properties": {
        "kind": { "enum": ["existing-design-system", "mini-design-brief"] },
        "contractSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": { "type": "string", "minLength": 3 },
              "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            }
          }
        },
        "selectedDirectionId": { "type": ["string", "null"] }
      }
    },
    "stages": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "summary", "evidence"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "status": { "enum": ["passed", "ready", "external-blocked", "failed"] },
          "summary": { "type": "string", "minLength": 8 },
          "evidence": { "type": "array", "items": { "type": "string", "minLength": 3 } }
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pageEntry", "visualMetrics", "visualHeatmap", "figmaEvidence"],
      "properties": {
        "pageEntry": { "type": "string", "minLength": 3 },
        "visualMetrics": { "type": "string", "minLength": 3 },
        "visualHeatmap": { "type": "string", "minLength": 3 },
        "figmaEvidence": { "type": "string", "minLength": 3 }
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dependency", "reason", "resumeRequirements"],
        "properties": {
          "dependency": { "type": "string", "minLength": 3 },
          "reason": { "type": "string", "minLength": 8 },
          "resumeRequirements": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 4 } }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "designContext": { "const": "existing" } }, "required": ["designContext"] },
      "then": {
        "properties": {
          "routing": {
            "type": "object",
            "properties": {
              "selectedRoute": { "const": "existing" },
              "image2Policy": { "const": "forbidden" },
              "pipeline": { "const": ["design-contract", "figma-or-component-foundation", "pattern-recipe", "implementation", "verification"] }
            },
            "required": ["selectedRoute", "image2Policy", "pipeline"]
          },
          "stages": {
            "not": {
              "type": "array",
              "contains": {
                "type": "object",
                "properties": { "id": { "enum": ["gpt-image-2", "image-to-html"] } },
                "required": ["id"]
              }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "designContext": { "const": "exploratory" } }, "required": ["designContext"] },
      "then": {
        "properties": {
          "routing": {
            "type": "object",
            "properties": {
              "selectedRoute": { "const": "exploratory" },
              "image2Policy": { "const": "allowed-visual-exploration-only" },
              "pipeline": { "const": ["frozen-visual-brief", "gpt-image-2", "image-to-html", "implementation", "verification"] }
            },
            "required": ["selectedRoute", "image2Policy", "pipeline"]
          },
          "stages": {
            "type": "array",
            "allOf": [
              { "type": "array", "contains": { "type": "object", "properties": { "id": { "const": "gpt-image-2" } }, "required": ["id"] } },
              { "type": "array", "contains": { "type": "object", "properties": { "id": { "const": "image-to-html" } }, "required": ["id"] } }
            ]
          }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "external-blocked" } }, "required": ["status"] },
      "then": { "properties": { "blockers": { "type": "array", "minItems": 1 } } }
    },
    {
      "if": { "properties": { "status": { "const": "completed" } }, "required": ["status"] },
      "then": {
        "properties": {
          "blockers": { "type": "array", "maxItems": 0 },
          "stages": {
            "type": "array",
            "items": { "type": "object", "properties": { "status": { "const": "passed" } }, "required": ["status"] }
          }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "in-progress" } }, "required": ["status"] },
      "then": {
        "properties": {
          "blockers": { "type": "array", "maxItems": 0 },
          "stages": {
            "type": "array",
            "contains": { "type": "object", "properties": { "status": { "const": "ready" } }, "required": ["status"] },
            "items": { "type": "object", "properties": { "status": { "enum": ["passed", "ready"] } }, "required": ["status"] }
          }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "external-blocked" } }, "required": ["status"] },
      "then": {
        "properties": {
          "stages": {
            "type": "array",
            "contains": { "type": "object", "properties": { "status": { "const": "external-blocked" } }, "required": ["status"] }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "stages": {
            "type": "array",
            "contains": { "type": "object", "properties": { "status": { "const": "failed" } }, "required": ["status"] }
          }
        },
        "required": ["stages"]
      },
      "then": { "properties": { "status": { "const": "failed" } } }
    },
    {
      "if": { "properties": { "status": { "const": "failed" } }, "required": ["status"] },
      "then": {
        "properties": {
          "stages": {
            "type": "array",
            "contains": { "type": "object", "properties": { "status": { "const": "failed" } }, "required": ["status"] }
          }
        }
      }
    }
  ]
}
