{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-readable.local/schema/feedback.schema.json",
  "title": "AI-readable Feedback Queue",
  "type": "object",
  "required": ["version", "projectId", "items"],
  "properties": {
    "version": { "type": "string" },
    "projectId": { "type": "string" },
    "items": {
      "type": "array",
      "items": { "$ref": "#/$defs/FeedbackItem" }
    }
  },
  "$defs": {
    "FeedbackItem": {
      "type": "object",
      "required": [
        "id",
        "source",
        "target",
        "status",
        "severity",
        "title",
        "finding",
        "evidence",
        "proposedChange",
        "promotion",
        "acceptance",
        "createdAt"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^fb-[0-9]{8}-[0-9]{3}$" },
        "source": { "enum": ["manual-edit", "chat-edit", "qa", "engineer", "harness"] },
        "target": { "enum": ["component", "page", "rule", "token", "demo"] },
        "status": { "enum": ["queued", "accepted", "promoted", "rejected"] },
        "severity": { "enum": ["low", "medium", "high", "critical"] },
        "reviewer": { "type": "string", "minLength": 2 },
        "reviewedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "pageId": { "type": "string" },
        "generatedFile": { "type": "string" },
        "title": { "type": "string", "minLength": 6 },
        "finding": { "type": "string", "minLength": 12 },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 6 }
        },
        "proposedChange": { "type": "string", "minLength": 12 },
        "promotion": {
          "type": "object",
          "required": ["destination", "action", "requiresReview"],
          "properties": {
            "destination": { "type": "string" },
            "action": { "enum": ["update-rule", "update-component", "update-token", "save-demo", "update-page-plan"] },
            "requiresReview": { "type": "boolean" }
          }
        },
        "promotionEvidence": { "$ref": "#/$defs/PromotionEvidence" },
        "acceptance": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 6 }
        },
        "createdAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "enum": ["accepted", "promoted"] } },
            "required": ["status"]
          },
          "then": { "required": ["reviewer", "reviewedAt"] }
        },
        {
          "if": {
            "properties": { "status": { "const": "rejected" } },
            "required": ["status"]
          },
          "then": { "required": ["reviewer", "reviewedAt", "rejectionReason"] }
        }
      ]
    },
    "PromotionEvidence": {
      "type": "object",
      "properties": {
        "evidencePolicy": { "enum": ["strict-v1"] },
        "componentPlan": { "type": "string", "minLength": 1 },
        "plannedFiles": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "patchPlan": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "implementation": {
          "type": "object",
          "required": ["files"],
          "properties": {
            "files": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/HashedFile" }
            }
          }
        },
        "regression": {
          "type": "object",
          "required": ["commands"],
          "properties": {
            "commands": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/CommandResult" }
            }
          }
        },
        "evidenceArtifacts": {
          "type": "object",
          "properties": {
            "harness": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/EvidenceArtifact" }
            },
            "browser": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/EvidenceArtifact" }
            },
            "visual": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/EvidenceArtifact" }
            }
          }
        }
      },
      "additionalProperties": true
    },
    "HashedFile": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "CommandResult": {
      "type": "object",
      "required": ["command", "status"],
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "status": { "enum": ["passed", "failed", "incomplete"] },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/EvidenceArtifact" }
        }
      },
      "additionalProperties": false
    },
    "EvidenceArtifact": {
      "type": "object",
      "required": ["type", "status"],
      "properties": {
        "type": { "enum": ["harness", "browser", "visual", "command-log"] },
        "status": { "enum": ["passed", "failed", "incomplete"] },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "reason": { "type": "string", "minLength": 6 }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "passed" } },
            "required": ["status"]
          },
          "then": { "required": ["path", "sha256"] }
        },
        {
          "if": {
            "properties": { "status": { "const": "incomplete" } },
            "required": ["status"]
          },
          "then": { "required": ["reason"] }
        }
      ]
    }
  }
}
