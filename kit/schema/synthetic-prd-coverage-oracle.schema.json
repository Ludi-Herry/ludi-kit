{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-readable.local/schema/synthetic-prd-coverage-oracle.schema.json",
  "title": "Synthetic PRD Coverage Oracle",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "version", "owner", "profiles"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": "1.0.0" },
    "owner": { "const": "blind-readiness-harness" },
    "profiles": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/profile" }
    }
  },
  "$defs": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profileId", "expected", "coverage"],
      "properties": {
        "profileId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pageCount",
            "flowCount",
            "entityCount",
            "fieldUnitsTotal",
            "flowStepCounts",
            "requirementCount"
          ],
          "properties": {
            "pageCount": { "type": "integer", "minimum": 1 },
            "flowCount": { "type": "integer", "minimum": 1 },
            "entityCount": { "type": "integer", "minimum": 1 },
            "fieldUnitsTotal": { "type": "integer", "minimum": 1 },
            "flowStepCounts": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "integer", "minimum": 2 }
            },
            "requirementCount": { "type": "integer", "minimum": 6 }
          }
        },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["perStepKinds", "perFlowKinds", "appendRecoveryStep"],
          "properties": {
            "perStepKinds": {
              "const": ["action", "state"]
            },
            "perFlowKinds": {
              "const": ["side-effect", "recovery"]
            },
            "appendRecoveryStep": { "const": true }
          }
        }
      }
    }
  }
}
