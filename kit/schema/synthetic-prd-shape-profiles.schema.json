{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-readable.local/schema/synthetic-prd-shape-profiles.schema.json",
  "title": "Synthetic Blind PRD Shape Profiles",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "version", "owner", "profiles"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": "1.0.0" },
    "owner": { "const": "harness/synthetic-prd/shape-profiles.json" },
    "profiles": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/profile" }
    }
  },
  "$defs": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profileId",
        "confidence",
        "pagePatterns",
        "fieldUnitsByPage",
        "flowStepCounts",
        "entityFieldCounts",
        "entityRecordCounts",
        "derived"
      ],
      "properties": {
        "profileId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "confidence": { "enum": ["medium", "high"] },
        "pagePatterns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": ["dashboard-page", "list-page", "detail-page", "form-page"]
          }
        },
        "fieldUnitsByPage": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer", "minimum": 1, "maximum": 40 }
        },
        "flowStepCounts": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer", "minimum": 2, "maximum": 20 }
        },
        "entityFieldCounts": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer", "minimum": 1, "maximum": 50 }
        },
        "entityRecordCounts": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer", "minimum": 1, "maximum": 50 }
        },
        "derived": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pageCount",
            "flowCount",
            "entityCount",
            "fieldUnitsTotal",
            "fieldDensity"
          ],
          "properties": {
            "pageCount": { "type": "integer", "minimum": 1 },
            "flowCount": { "type": "integer", "minimum": 1 },
            "entityCount": { "type": "integer", "minimum": 1 },
            "fieldUnitsTotal": { "type": "integer", "minimum": 1 },
            "fieldDensity": { "type": "number", "exclusiveMinimum": 0 }
          }
        }
      }
    }
  }
}
