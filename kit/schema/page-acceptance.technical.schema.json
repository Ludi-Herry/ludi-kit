{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-readable.local/schema/page-acceptance.technical.schema.json",
  "title": "Page acceptance technical evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "projectId", "evidenceType", "generatedAt", "routeBase", "pages"],
  "properties": {
    "version": { "type": "string" },
    "projectId": { "type": "string", "minLength": 1 },
    "evidenceType": { "const": "technical" },
    "generatedAt": { "type": "string", "minLength": 1 },
    "routeBase": { "type": "string" },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/pageTechnicalEvidence" }
    }
  },
  "$defs": {
    "pageTechnicalEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pageId", "route", "fullRoute", "status", "viewport", "keyInteractions", "console", "overflow"],
      "properties": {
        "pageId": { "type": "string", "minLength": 1 },
        "route": { "type": "string", "pattern": "^/" },
        "fullRoute": { "type": "string", "pattern": "^/" },
        "status": { "enum": ["ready", "passed", "failed"] },
        "viewport": { "$ref": "#/$defs/viewport" },
        "keyInteractions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/keyInteraction" }
        },
        "console": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "errors", "warnings"],
          "properties": {
            "status": { "enum": ["ready", "passed", "failed"] },
            "errors": { "type": "array", "items": { "type": "string" } },
            "warnings": { "type": "array", "items": { "type": "string" } }
          }
        },
        "overflow": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "page", "containers"],
          "properties": {
            "status": { "enum": ["ready", "passed", "failed"] },
            "page": { "$ref": "#/$defs/overflowTarget" },
            "containers": {
              "type": "array",
              "items": { "$ref": "#/$defs/overflowTarget" }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "passed" } },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "keyInteractions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["result"]
                }
              },
              "console": {
                "type": "object",
                "properties": {
                  "errors": { "type": "array", "maxItems": 0 },
                  "warnings": { "type": "array", "maxItems": 0 }
                }
              },
              "overflow": {
                "type": "object",
                "properties": {
                  "page": {
                    "type": "object",
                    "properties": {
                      "hasHorizontalOverflow": { "const": false }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "width", "height"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "width": { "type": "integer", "minimum": 320 },
        "height": { "type": "integer", "minimum": 480 }
      }
    },
    "keyInteraction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "steps", "assertions"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "assertions": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "result": { "enum": ["passed", "failed"] }
      }
    },
    "overflowTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selector", "hasHorizontalOverflow", "hasVerticalOverflow"],
      "properties": {
        "selector": { "type": "string", "minLength": 1 },
        "hasHorizontalOverflow": { "type": ["boolean", "null"] },
        "hasVerticalOverflow": { "type": ["boolean", "null"] }
      }
    }
  }
}
