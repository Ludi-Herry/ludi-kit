{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://radesign.local/schema/blind-prd-input-receipt.schema.json",
  "title": "Blind PRD Input Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "runId",
    "slot",
    "status",
    "receivedAt",
    "preRevealContract",
    "source",
    "eligibility",
    "disclosure"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "enum": ["1.0.0", "1.1.0"] },
    "runId": {
      "type": "string",
      "pattern": "^blind-prd-(0[1-5])(?:-[a-z0-9][a-z0-9-]*)?$"
    },
    "slot": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "attemptNumber": {
      "type": "integer",
      "minimum": 1
    },
    "status": { "const": "received-unopened" },
    "receivedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "preRevealContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "freezeCommit"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^quality/blind-runs/blind-prd-(0[1-5])(?:-[a-z0-9][a-z0-9-]*)?/pre-reveal-contract\\.json$"
        },
        "sha256": { "$ref": "#/$defs/sha256" },
        "freezeCommit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "fileName", "bytes", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 3 },
        "fileName": { "type": "string", "minLength": 1 },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "eligibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "independentRealPrd",
        "informedKitConstruction",
        "previouslyInspectedByGenerationAgents"
      ],
      "properties": {
        "independentRealPrd": { "const": true },
        "informedKitConstruction": { "const": false },
        "previouslyInspectedByGenerationAgents": { "const": false }
      }
    },
    "disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metadataRecorded", "contentOpenedAt"],
      "properties": {
        "metadataRecorded": { "const": true },
        "contentOpenedAt": { "type": "null" }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "version": { "const": "1.0.0" } },
        "required": ["version"]
      },
      "then": {
        "properties": { "attemptNumber": false }
      }
    },
    {
      "if": {
        "properties": { "version": { "const": "1.1.0" } },
        "required": ["version"]
      },
      "then": {
        "required": ["attemptNumber"]
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
