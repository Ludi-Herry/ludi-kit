{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-readable.local/schema/page-acceptance.visual.schema.json",
  "title": "Page acceptance visual evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "projectId", "evidenceType", "generatedAt", "routeBase", "pages"],
  "properties": {
    "version": { "type": "string" },
    "projectId": { "type": "string", "minLength": 1 },
    "evidenceType": { "const": "visual" },
    "generatedAt": { "type": "string", "minLength": 1 },
    "routeBase": { "type": "string" },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/pageVisualEvidence" }
    }
  },
  "$defs": {
    "pageVisualEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pageId", "route", "fullRoute", "status", "rawStatus", "viewport", "screenshots", "review"],
      "properties": {
        "pageId": { "type": "string", "minLength": 1 },
        "route": { "type": "string", "pattern": "^/" },
        "fullRoute": { "type": "string", "pattern": "^/" },
        "status": { "enum": ["ready", "passed", "failed", "unreviewed", "external-blocked"] },
        "rawStatus": { "enum": ["ready", "passed", "failed", "external-blocked"] },
        "viewport": { "$ref": "#/$defs/viewport" },
        "screenshots": {
          "type": "object",
          "additionalProperties": false,
          "required": ["baseline", "baselineSha256", "current", "currentSha256", "diff", "diffSha256"],
          "properties": {
            "baseline": { "type": ["string", "null"] },
            "baselineSha256": { "$ref": "#/$defs/sha256OrNull" },
            "current": { "type": ["string", "null"] },
            "currentSha256": { "$ref": "#/$defs/sha256OrNull" },
            "diff": { "type": ["string", "null"] },
            "diffSha256": { "$ref": "#/$defs/sha256OrNull" }
          }
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "notes"],
          "properties": {
            "state": { "enum": ["ready", "accepted", "rejected", "unreviewed", "external-blocked"] },
            "notes": { "type": "array", "items": { "type": "string" } }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "passed" } },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "rawStatus": { "const": "passed" },
              "screenshots": {
                "type": "object",
                "properties": {
                  "current": { "type": "string", "minLength": 1 },
                  "currentSha256": { "$ref": "#/$defs/sha256" }
                }
              },
              "review": {
                "type": "object",
                "properties": {
                  "state": { "const": "accepted" }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "rawStatus": { "const": "failed" } },
            "required": ["rawStatus"]
          },
          "then": {
            "properties": {
              "status": { "not": { "const": "passed" } }
            }
          }
        }
      ]
    },
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "width", "height"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "width": { "type": "integer", "minimum": 320 },
        "height": { "type": "integer", "minimum": 480 }
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sha256OrNull": {
      "anyOf": [
        { "$ref": "#/$defs/sha256" },
        { "type": "null" }
      ]
    }
  }
}
