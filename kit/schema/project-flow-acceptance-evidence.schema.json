{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://radesign.local/schema/project-flow-acceptance-evidence.schema.json",
  "title": "Radesign Flow Acceptance Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "runId",
    "arm",
    "projectId",
    "artifactId",
    "evaluatorId",
    "revision",
    "attemptId",
    "status",
    "command",
    "exitCode",
    "signal",
    "error",
    "timeIdentity",
    "artifact",
    "evaluatorReceipt",
    "outputs",
    "runtimeIdentity",
    "runtimeIdentityObserved",
    "runtimeAudit",
    "runtimeAuditCompleted",
    "preflightCompleted",
    "approvedFlows",
    "stepProofs",
    "recoveryProofs",
    "assertionProofs",
    "observationProofs",
    "screenshots",
    "metrics"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": "1.2.0" },
    "runId": { "$ref": "#/$defs/runId" },
    "arm": { "enum": ["consumer", "control"] },
    "projectId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "artifactId": { "$ref": "#/$defs/uuidV4" },
    "evaluatorId": {
      "type": "string",
      "pattern": "^eval-blind-prd-(0[1-5])(?:-[a-z0-9][a-z0-9-]*)?$"
    },
    "revision": { "type": "integer", "minimum": 1, "maximum": 2 },
    "attemptId": {
      "type": "string",
      "pattern": "^attempt-[0-9]{2}$"
    },
    "status": { "enum": ["passed", "failed"] },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executable", "args", "cwd"],
      "properties": {
        "executable": { "type": "string", "minLength": 1 },
        "args": {
          "type": "array",
          "items": { "type": "string" }
        },
        "cwd": { "type": "string", "minLength": 1 }
      }
    },
    "exitCode": { "type": ["integer", "null"] },
    "signal": { "type": ["string", "null"] },
    "error": { "type": ["string", "null"] },
    "timeIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startedAt", "finishedAt", "durationMs"],
      "properties": {
        "startedAt": { "$ref": "#/$defs/dateTime" },
        "finishedAt": { "$ref": "#/$defs/dateTime" },
        "durationMs": { "type": "integer", "minimum": 0 }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receipt", "seal", "sourceSha256", "buildSha256"],
      "properties": {
        "receipt": { "$ref": "#/$defs/fileHash" },
        "seal": { "$ref": "#/$defs/fileHash" },
        "sourceSha256": { "$ref": "#/$defs/sha256" },
        "buildSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "evaluatorReceipt": { "$ref": "#/$defs/fileHash" },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stdout",
        "stderr",
        "previewStdout",
        "previewStderr",
        "interactionRuntime",
        "playwrightReport",
        "assertionReporter",
        "assertionRuntime"
      ],
      "properties": {
        "stdout": { "$ref": "#/$defs/rawFile" },
        "stderr": { "$ref": "#/$defs/rawFile" },
        "previewStdout": { "$ref": "#/$defs/rawFile" },
        "previewStderr": { "$ref": "#/$defs/rawFile" },
        "interactionRuntime": { "$ref": "#/$defs/rawFile" },
        "playwrightReport": { "$ref": "#/$defs/rawFile" },
        "assertionReporter": { "$ref": "#/$defs/rawFile" },
        "assertionRuntime": { "$ref": "#/$defs/rawFile" }
      }
    },
    "runtimeIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "arm", "projectId", "artifactId"],
      "properties": {
        "runId": { "$ref": "#/$defs/runId" },
        "arm": { "enum": ["consumer", "control"] },
        "projectId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "artifactId": { "$ref": "#/$defs/uuidV4" }
      }
    },
    "runtimeIdentityObserved": { "type": "boolean" },
    "runtimeAudit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consoleErrors",
        "consoleWarnings",
        "pageErrors",
        "unexpectedHttpErrors"
      ],
      "properties": {
        "consoleErrors": { "type": "integer", "minimum": 0 },
        "consoleWarnings": { "type": "integer", "minimum": 0 },
        "pageErrors": { "type": "integer", "minimum": 0 },
        "unexpectedHttpErrors": { "type": "integer", "minimum": 0 }
      }
    },
    "runtimeAuditCompleted": { "type": "boolean" },
    "preflightCompleted": { "type": "boolean" },
    "approvedFlows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["flowId", "objectRefs", "specPath"],
        "properties": {
          "flowId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "objectRefs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "specPath": { "type": "string", "minLength": 1 }
        }
      }
    },
    "stepProofs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "flowId",
          "stepId",
          "interactionId",
          "pageId",
          "action",
          "locatorMode",
          "matchedCount",
          "visible",
          "actionExecuted",
          "routeBefore",
          "routeAfter",
          "checkedAt",
          "evaluatorId",
          "revision"
        ],
        "properties": {
          "flowId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "stepId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "interactionId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "pageId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "action": { "type": "string", "minLength": 1 },
          "locatorMode": {
            "enum": ["data-interaction-id", "frozen-adapter"]
          },
          "matchedCount": { "type": ["integer", "null"], "minimum": 0 },
          "visible": { "type": ["boolean", "null"] },
          "actionExecuted": { "type": ["boolean", "null"] },
          "routeBefore": {
            "oneOf": [
              { "type": "string", "pattern": "^/" },
              { "type": "null" }
            ]
          },
          "routeAfter": {
            "oneOf": [
              { "type": "string", "pattern": "^/" },
              { "type": "null" }
            ]
          },
          "checkedAt": {
            "oneOf": [
              { "$ref": "#/$defs/dateTime" },
              { "type": "null" }
            ]
          },
          "evaluatorId": {
            "type": "string",
            "pattern": "^eval-blind-prd-(0[1-5])(?:-[a-z0-9][a-z0-9-]*)?$"
          },
          "revision": { "type": "integer", "minimum": 1, "maximum": 2 }
        }
      }
    },
    "recoveryProofs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "flowId",
          "interactionId",
          "action",
          "expectedRoute",
          "locatorMode",
          "matchedCount",
          "visible",
          "actionExecuted",
          "routeBefore",
          "routeAfter",
          "checkedAt",
          "evaluatorId",
          "revision"
        ],
        "properties": {
          "flowId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "interactionId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "action": { "type": "string", "minLength": 1 },
          "expectedRoute": { "type": "string", "pattern": "^/" },
          "locatorMode": {
            "enum": ["data-interaction-id", "frozen-adapter"]
          },
          "matchedCount": { "type": ["integer", "null"], "minimum": 0 },
          "visible": { "type": ["boolean", "null"] },
          "actionExecuted": { "type": ["boolean", "null"] },
          "routeBefore": {
            "oneOf": [
              { "type": "string", "pattern": "^/" },
              { "type": "null" }
            ]
          },
          "routeAfter": {
            "oneOf": [
              { "type": "string", "pattern": "^/" },
              { "type": "null" }
            ]
          },
          "checkedAt": {
            "oneOf": [
              { "$ref": "#/$defs/dateTime" },
              { "type": "null" }
            ]
          },
          "evaluatorId": {
            "type": "string",
            "pattern": "^eval-blind-prd-(0[1-5])(?:-[a-z0-9][a-z0-9-]*)?$"
          },
          "revision": { "type": "integer", "minimum": 1, "maximum": 2 }
        }
      }
    },
    "assertionProofs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "flowId",
          "stepId",
          "expectedState",
          "assertionRefs",
          "sideEffect",
          "token",
          "testTitle",
          "testStatus",
          "expectedStatus",
          "outcome",
          "retry",
          "tokenStepCount",
          "expectCount",
          "failedExpectCount",
          "executed",
          "checkedAt",
          "evaluatorId",
          "revision"
        ],
        "properties": {
          "kind": { "enum": ["step-state", "flow-side-effect"] },
          "flowId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "stepId": {
            "oneOf": [
              { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
              { "type": "null" }
            ]
          },
          "expectedState": { "type": ["string", "null"] },
          "assertionRefs": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "sideEffect": { "type": ["string", "null"] },
          "token": {
            "type": "string",
            "pattern": "^blind-proof-v1:[0-9a-f]{64}$"
          },
          "testTitle": { "type": ["string", "null"] },
          "testStatus": {
            "oneOf": [
              { "enum": ["passed", "failed", "timedOut", "skipped", "interrupted"] },
              { "type": "null" }
            ]
          },
          "expectedStatus": {
            "oneOf": [
              { "enum": ["passed", "failed", "skipped"] },
              { "type": "null" }
            ]
          },
          "outcome": {
            "oneOf": [
              { "enum": ["expected", "unexpected", "flaky", "skipped"] },
              { "type": "null" }
            ]
          },
          "retry": { "type": ["integer", "null"], "minimum": 0 },
          "tokenStepCount": { "type": "integer", "minimum": 0 },
          "expectCount": { "type": "integer", "minimum": 0 },
          "failedExpectCount": { "type": "integer", "minimum": 0 },
          "executed": { "type": "boolean" },
          "checkedAt": {
            "oneOf": [
              { "$ref": "#/$defs/dateTime" },
              { "type": "null" }
            ]
          },
          "evaluatorId": {
            "type": "string",
            "pattern": "^eval-blind-prd-(0[1-5])(?:-[a-z0-9][a-z0-9-]*)?$"
          },
          "revision": { "type": "integer", "minimum": 1, "maximum": 2 }
        }
      }
    },
    "observationProofs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "flowId",
          "stepId",
          "assertionId",
          "assertionRef",
          "targetId",
          "matcher",
          "attribute",
          "expected",
          "observed",
          "matchedCount",
          "passed",
          "checkedAt",
          "evaluatorId",
          "revision"
        ],
        "properties": {
          "kind": { "enum": ["step-state", "flow-side-effect"] },
          "flowId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "stepId": {
            "oneOf": [
              { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
              { "type": "null" }
            ]
          },
          "assertionId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "assertionRef": { "type": ["string", "null"] },
          "targetId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "matcher": {
            "enum": ["visible", "text-equals", "text-includes", "attribute-equals"]
          },
          "attribute": { "type": ["string", "null"] },
          "expected": { "type": ["boolean", "string"] },
          "observed": { "type": ["boolean", "string", "null"] },
          "matchedCount": { "type": ["integer", "null"], "minimum": 0 },
          "passed": { "type": "boolean" },
          "checkedAt": {
            "oneOf": [
              { "$ref": "#/$defs/dateTime" },
              { "type": "null" }
            ]
          },
          "evaluatorId": {
            "type": "string",
            "pattern": "^eval-blind-prd-(0[1-5])(?:-[a-z0-9][a-z0-9-]*)?$"
          },
          "revision": { "type": "integer", "minimum": 1, "maximum": 2 }
        },
        "allOf": [
          {
            "oneOf": [
              {
                "properties": {
                  "kind": { "const": "step-state" },
                  "stepId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
                  "assertionRef": { "type": "string", "minLength": 1 }
                }
              },
              {
                "properties": {
                  "kind": { "const": "flow-side-effect" },
                  "stepId": { "type": "null" },
                  "assertionRef": { "type": "null" }
                }
              }
            ]
          },
          {
            "oneOf": [
              {
                "properties": {
                  "matcher": { "const": "visible" },
                  "attribute": { "type": "null" },
                  "expected": { "type": "boolean" },
                  "observed": { "type": ["boolean", "null"] }
                }
              },
              {
                "properties": {
                  "matcher": { "const": "text-equals" },
                  "attribute": { "type": "null" },
                  "expected": { "type": "string", "minLength": 1 },
                  "observed": { "type": ["string", "null"] }
                }
              },
              {
                "properties": {
                  "matcher": { "const": "text-includes" },
                  "attribute": { "type": "null" },
                  "expected": { "type": "string", "minLength": 1 },
                  "observed": { "type": ["string", "null"] }
                }
              },
              {
                "properties": {
                  "matcher": { "const": "attribute-equals" },
                  "attribute": { "type": "string", "minLength": 1 },
                  "expected": { "type": "string", "minLength": 1 },
                  "observed": { "type": ["string", "null"] }
                }
              }
            ]
          }
        ]
      }
    },
    "screenshots": {
      "type": "array",
      "items": { "$ref": "#/$defs/fileHash" }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sameArtifactMismatchCount",
        "evidenceCompleteness",
        "approvedCrossPageFlowCount",
        "fixtureProductProofCount",
        "interactionIdentityMismatchCount",
        "observableAssertionMismatchCount"
      ],
      "properties": {
        "sameArtifactMismatchCount": { "type": "integer", "minimum": 0 },
        "evidenceCompleteness": { "type": "integer", "minimum": 0, "maximum": 100 },
        "approvedCrossPageFlowCount": { "type": "integer", "minimum": 0 },
        "fixtureProductProofCount": { "type": "integer", "minimum": 0 },
        "interactionIdentityMismatchCount": { "type": "integer", "minimum": 0 },
        "observableAssertionMismatchCount": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "passed" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "exitCode": { "const": 0 },
          "error": { "type": "null" },
          "preflightCompleted": { "const": true },
          "runtimeIdentityObserved": { "const": true },
          "runtimeAuditCompleted": { "const": true },
          "screenshots": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/fileHash" }
          },
          "runtimeAudit": {
            "type": "object",
            "properties": {
              "consoleErrors": { "const": 0 },
              "consoleWarnings": { "const": 0 },
              "pageErrors": { "const": 0 },
              "unexpectedHttpErrors": { "const": 0 }
            }
          },
          "metrics": {
            "type": "object",
            "properties": {
              "sameArtifactMismatchCount": { "const": 0 },
              "evidenceCompleteness": { "const": 100 },
              "approvedCrossPageFlowCount": { "type": "integer", "minimum": 1 },
              "fixtureProductProofCount": { "const": 0 },
              "interactionIdentityMismatchCount": { "const": 0 },
              "observableAssertionMismatchCount": { "const": 0 }
            }
          },
          "stepProofs": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "properties": {
                "matchedCount": { "const": 1 },
                "visible": { "const": true },
                "actionExecuted": { "const": true },
                "routeBefore": { "type": "string", "pattern": "^/" },
                "routeAfter": { "type": "string", "pattern": "^/" },
                "checkedAt": { "$ref": "#/$defs/dateTime" }
              }
            }
          },
          "recoveryProofs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "matchedCount": { "const": 1 },
                "visible": { "const": true },
                "actionExecuted": { "const": true },
                "routeBefore": { "type": "string", "pattern": "^/" },
                "routeAfter": { "type": "string", "pattern": "^/" },
                "checkedAt": { "$ref": "#/$defs/dateTime" }
              }
            }
          },
          "assertionProofs": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "object",
              "properties": {
                "testStatus": { "const": "passed" },
                "expectedStatus": { "const": "passed" },
                "outcome": { "const": "expected" },
                "retry": { "const": 0 },
                "tokenStepCount": { "const": 1 },
                "expectCount": { "type": "integer", "minimum": 1 },
                "failedExpectCount": { "const": 0 },
                "executed": { "const": true },
                "checkedAt": { "$ref": "#/$defs/dateTime" }
              }
            }
          },
          "observationProofs": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "object",
              "properties": {
                "matchedCount": { "const": 1 },
                "passed": { "const": true },
                "checkedAt": { "$ref": "#/$defs/dateTime" }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "uuidV4": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "runId": {
      "type": "string",
      "pattern": "^blind-prd-(0[1-5])(?:-[a-z0-9][a-z0-9-]*)?$"
    },
    "dateTime": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "fileHash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "rawFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
