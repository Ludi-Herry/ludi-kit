{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-readable.local/schema/project-sample-pack.schema.json",
  "title": "AI-readable Project Sample Pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "projectId", "label", "entities"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": "1.0.0" },
    "projectId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "label": {
      "type": "string",
      "minLength": 8,
      "pattern": "([Dd]emonstration|[Dd]emo|示例|演示)"
    },
    "entities": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[A-Z][A-Za-z0-9]*$"
      },
      "additionalProperties": {
        "type": "object",
        "minProperties": 1,
        "propertyNames": {
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "additionalProperties": {
          "type": "object",
          "minProperties": 2,
          "required": ["id"],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            }
          },
          "additionalProperties": {
            "type": ["string", "number", "boolean", "null"]
          }
        }
      }
    }
  }
}
