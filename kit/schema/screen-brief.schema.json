{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-readable.local/schema/screen-brief.schema.json",
  "title": "Situation-screen brief (screenBrief v1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "title", "businessBrief", "viewports", "dataFreshness", "aggregationRules", "panels", "map", "states", "motion", "performanceTarget", "renderer"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "title": { "type": "string", "minLength": 3 },
    "businessBrief": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "audience"],
      "properties": {
        "summary": { "type": "string", "minLength": 12 },
        "audience": { "type": "string", "minLength": 4 }
      }
    },
    "viewports": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/viewport" }
    },
    "dataFreshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "maxStaleSeconds"],
      "properties": {
        "mode": { "enum": ["realtime", "near-realtime", "batch"] },
        "maxStaleSeconds": { "type": "integer", "exclusiveMinimum": 0 },
        "note": { "type": "string", "minLength": 8 }
      }
    },
    "aggregationRules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/aggregationRule" }
    },
    "panels": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/panel" }
    },
    "map": { "$ref": "#/$defs/mapSource" },
    "states": {
      "type": "object",
      "additionalProperties": false,
      "required": ["loading", "empty", "error"],
      "properties": {
        "loading": { "$ref": "#/$defs/stateBehavior" },
        "empty": { "$ref": "#/$defs/stateBehavior" },
        "error": { "$ref": "#/$defs/stateBehavior" }
      }
    },
    "motion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interruptible", "reducedMotionFallback"],
      "properties": {
        "interruptible": { "const": true },
        "reducedMotionFallback": { "type": "string", "minLength": 8 }
      }
    },
    "performanceTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targets", "dprDegradation"],
      "properties": {
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/perfGate" }
        },
        "dprDegradation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maxDevicePixelRatio", "strategy"],
          "properties": {
            "maxDevicePixelRatio": { "type": "number", "exclusiveMinimum": 0, "maximum": 4 },
            "strategy": { "type": "string", "minLength": 12 }
          }
        }
      }
    },
    "renderer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mainRenderer", "minContext", "browserSupport"],
      "properties": {
        "mainRenderer": { "type": "string", "minLength": 3 },
        "minContext": { "enum": ["webgl2", "webgl1"] },
        "browserSupport": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 3 }
        },
        "budgetNote": { "type": "string", "minLength": 8 }
      }
    },
    "splineScene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sceneUrl", "publicationRightsNote"],
      "properties": {
        "sceneUrl": { "type": ["string", "null"] },
        "publicationRightsNote": { "type": ["string", "null"] }
      }
    },
    "figmaTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileKey", "nodeId"],
      "properties": {
        "fileKey": { "type": ["string", "null"] },
        "nodeId": { "type": ["string", "null"] }
      }
    }
  },
  "$defs": {
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tier", "width", "height"],
      "properties": {
        "tier": { "enum": ["1080p", "768p", "4k", "custom"] },
        "width": { "type": "integer", "minimum": 960, "maximum": 7680 },
        "height": { "type": "integer", "minimum": 600, "maximum": 4320 },
        "deviceScaleFactor": { "type": "number", "exclusiveMinimum": 0, "maximum": 4 },
        "role": { "enum": ["primary", "secondary"] }
      },
      "allOf": [
        {
          "if": { "properties": { "tier": { "const": "1080p" } }, "required": ["tier"] },
          "then": { "properties": { "width": { "const": 1920 }, "height": { "const": 1080 } } }
        },
        {
          "if": { "properties": { "tier": { "const": "768p" } }, "required": ["tier"] },
          "then": { "properties": { "width": { "const": 1366 }, "height": { "const": 768 } } }
        },
        {
          "if": { "properties": { "tier": { "const": "4k" } }, "required": ["tier"] },
          "then": { "properties": { "width": { "const": 3840 }, "height": { "const": 2160 } } }
        }
      ]
    },
    "aggregationRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "window", "description"],
      "properties": {
        "scope": { "type": "string", "minLength": 4 },
        "window": { "type": "string", "minLength": 2 },
        "description": { "type": "string", "minLength": 8 }
      }
    },
    "panel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "kind", "placement"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "title": { "type": "string", "minLength": 2 },
        "kicker": { "type": "string", "minLength": 2 },
        "kind": { "enum": ["metric", "chart", "list"] },
        "placement": { "enum": ["side-left", "side-right", "footer"] },
        "description": { "type": "string", "minLength": 6 }
      }
    },
    "mapSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseLayer", "reviewRequirement"],
      "properties": {
        "baseLayer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sourceName", "version", "license", "attributionNote", "redistributionNote"],
          "properties": {
            "sourceName": { "type": "string", "minLength": 3 },
            "repository": { "type": "string", "minLength": 3 },
            "version": { "type": "string", "minLength": 3 },
            "commit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
            "license": { "type": "string", "minLength": 3 },
            "termsUrl": { "type": "string", "minLength": 8 },
            "attributionNote": { "type": "string", "minLength": 6 },
            "redistributionNote": { "type": "string", "minLength": 6 }
          }
        },
        "reviewRequirement": { "type": "string", "minLength": 8 }
      }
    },
    "stateBehavior": {
      "type": "object",
      "additionalProperties": false,
      "required": ["behavior"],
      "properties": {
        "behavior": { "type": "string", "minLength": 8 },
        "retry": { "type": "boolean" }
      }
    },
    "perfGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["viewportTier", "medianFpsMin", "p95FrameMsMax"],
      "properties": {
        "viewportTier": { "enum": ["1080p", "768p", "4k", "custom"] },
        "medianFpsMin": { "type": "number", "exclusiveMinimum": 0 },
        "p95FrameMsMax": { "type": "number", "exclusiveMinimum": 0 }
      }
    }
  }
}
