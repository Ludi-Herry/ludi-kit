{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-readable.local/schema/figma-audit.schema.json",
  "title": "Real Figma Component Audit Export",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "fileKey", "auditedAt", "scope", "components", "variables"],
  "properties": {
    "version": { "const": "1.0.0" },
    "fileKey": { "type": "string", "minLength": 6 },
    "auditedAt": { "type": "string", "format": "date-time" },
    "scope": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "nodeId", "componentKey", "properties", "useWhen", "avoidWhen"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "nodeId": { "type": "string", "pattern": "^[0-9]+:[0-9]+$" },
          "componentKey": { "type": "string", "minLength": 6 },
          "properties": { "type": "array", "items": { "type": "string" } },
          "useWhen": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "avoidWhen": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "variables": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "key", "type"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "key": { "type": "string", "minLength": 6 },
          "type": { "enum": ["COLOR", "FLOAT", "STRING", "BOOLEAN"] }
        }
      }
    }
  }
}
